APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_API_KEY=replace-with-local-development-key
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-home-assistant-long-lived-token
SQLITE_PATH=./data/homeassistant_proxy.sqlite3
CONFIG_ROOT=/config
FILE_BACKEND=local
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=root
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_ROOT=/config
READONLY_MODE=false
ALLOWED_WRITE_GLOBS=/config/packages/ai/*.yaml
ALLOWED_READ_GLOBS=/config/configuration.yaml,/config/automations.yaml,/config/scripts.yaml,/config/scenes.yaml,/config/climate.yaml,/config/packages/ai/*.yaml
ALLOWED_HA_SERVICES=automation.reload,script.reload,homeassistant.check_config,homeassistant.reload_all
MAX_FILE_SIZE_KB=256
REQUEST_TIMEOUT_SECONDS=10
HA_RELOAD_TIMEOUT_SECONDS=60
