APP_ENV=prod
ACTOR_NAME=owner

# Use a URL reachable from the Docker Desktop laptop.
# Examples:
# HA_BASE_URL=http://homeassistant.local:8123
# HA_BASE_URL=http://192.168.1.1:8123
HA_BASE_URL=http://homeassistant.local:8123

SFTP_HOST=homeassistant.local
SFTP_PORT=22
SFTP_USERNAME=root
SFTP_ROOT=/config

READONLY_MODE=false
ALLOWED_WRITE_GLOBS=/config/packages/ai/*.yaml
ALLOWED_READ_GLOBS=/config/configuration.yaml,/config/automations.yaml,/config/scripts.yaml,/config/scenes.yaml,/config/climate.yaml,/config/packages/ai/*.yaml
ALLOWED_HA_SERVICES=automation.reload,script.reload,homeassistant.reload_all

MAX_FILE_SIZE_KB=256
REQUEST_TIMEOUT_SECONDS=10
HA_RELOAD_TIMEOUT_SECONDS=60
